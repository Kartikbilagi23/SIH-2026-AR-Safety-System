generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SAFETY_OFFICER
}

enum Language {
  EN
  HI
  SAT
}


enum SiteZoneType {
  SAFE
  RESTRICTED
  HAZARD
  ASSEMBLY
}

enum HazardStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

model SiteZone {
  id          String        @id @default(cuid())
  name        String
  site        String
  description String?
  type        SiteZoneType  @default(SAFE)

  // JSON polygon: [{ "lat": 23.79, "lng": 86.43 }, ...]
  boundary    Json

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  locations   WorkerLocation[]
  ppeVerifications PPEVerification[]
  hazards     HazardReport[]

  @@index([site])
  @@index([site, type])
}

model WorkerLocation {
  id          String   @id @default(cuid())
  workerId    String
  zoneId      String?

  latitude    Float
  longitude   Float
  accuracyM   Float?
  reportedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  worker Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  zone   SiteZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([workerId, reportedAt])
  @@index([zoneId, reportedAt])
  @@index([reportedAt])
}

model HazardReport {
  id          String       @id @default(cuid())
  zoneId      String?
  site        String
  title       String
  description String?
  status      HazardStatus @default(OPEN)

  latitude    Float?
  longitude   Float?

  reportedBy  String?
  resolvedBy  String?
  reportedAt  DateTime     @default(now())
  resolvedAt  DateTime?

  zone SiteZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([site, status])
  @@index([zoneId, status])
  @@index([reportedAt])
}


enum ModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TrainingStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SAFETY_OFFICER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssessmentAnswer {
  id             String   @id @default(cuid())
  sessionId      String
  questionId     String
  selectedAnswer Int
  isCorrect      Boolean
  answeredAt     DateTime @default(now())

  session  TrainingSession @relation(fields: [sessionId],references: [id],onDelete: Cascade)

  question Question @relation(fields: [questionId],references: [id])

  @@unique([sessionId, questionId])
}

model Worker {
  id         String  @id @default(cuid())
  name       String
  employeeId String  @unique
  phone      String?
  sector     String?
  site       String?
  ppeVerifications PPEVerification[]
  language   String  @default("en")
  locations WorkerLocation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     TrainingSession[]
  certificates Certificate[]
}

enum PPEDetectionStatus {
  DETECTED
  NOT_DETECTED
  UNABLE_TO_VERIFY
}

model PPEVerification {
  id             String             @id @default(cuid())
  workerId       String?
  zoneId         String?
  site           String
  cameraId       String?
  
  helmetStatus   PPEDetectionStatus @default(UNABLE_TO_VERIFY)
  vestStatus     PPEDetectionStatus @default(UNABLE_TO_VERIFY)

  helmetConfidence Float?
  vestConfidence   Float?

  snapshotUrl    String?
  verifiedAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())

  worker Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  zone   SiteZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([workerId, verifiedAt])
  @@index([zoneId, verifiedAt])
  @@index([site, verifiedAt])
}


model TrainingModule {
  id          String       @id @default(cuid())
  category    String
  durationMin Int?
  status      ModuleStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ModuleTranslation[]
  questions    Question[]
  sessions     TrainingSession[]
  certificates Certificate[]
}

model ModuleTranslation {
  id       String   @id @default(cuid())
  moduleId String
  language Language

  title       String
  description String?

  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, language])
}

model Question {
  id       String @id @default(cuid())
  moduleId String

  correctAnswer Int

  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  translations QuestionTranslation[]
  answers AssessmentAnswer[]
}

model QuestionTranslation {
  id         String   @id @default(cuid())
  questionId String
  language   Language

  question String
  options  Json

  questionRef Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, language])
}

model TrainingSession {
  id       String @id @default(cuid())
  workerId String
  moduleId String

  score       Float?
  status      TrainingStatus @default(IN_PROGRESS)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  passed Boolean?
  worker Worker @relation(fields: [workerId], references: [id])
  attemptNumber Int @default(1)
  answers AssessmentAnswer[]
  module TrainingModule @relation(fields: [moduleId], references: [id])

  certificate Certificate?
}

model Certificate {
  id                String   @id @default(cuid())
  certificateNumber String   @unique

  workerId  String
  moduleId  String
  sessionId String   @unique

  issuedAt DateTime @default(now())

  worker  Worker         @relation(fields: [workerId], references: [id])
  module  TrainingModule @relation(fields: [moduleId], references: [id])
  session TrainingSession @relation(fields: [sessionId], references: [id])

  @@index([workerId])
  @@index([moduleId])
}