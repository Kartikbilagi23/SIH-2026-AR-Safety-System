generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SAFETY_OFFICER
}

enum ModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TrainingStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SAFETY_OFFICER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Worker {
  id         String  @id @default(cuid())
  name       String
  employeeId String  @unique
  phone      String?
  sector     String?
  site       String?
  language   String  @default("en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     TrainingSession[]
  certificates Certificate[]
}

model TrainingModule {
  id          String       @id @default(cuid())
  title       String
  description String?
  category    String
  durationMin Int?
  status      ModuleStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  sessions  TrainingSession[]
}

model Question {
  id       String @id @default(cuid())
  moduleId String

  question      String
  options       Json
  correctAnswer String

  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model TrainingSession {
  id       String @id @default(cuid())
  workerId String
  moduleId String

  score       Float?
  status      TrainingStatus @default(IN_PROGRESS)
  startedAt   DateTime       @default(now())
  completedAt DateTime?

  worker Worker @relation(fields: [workerId], references: [id])

  module TrainingModule @relation(fields: [moduleId], references: [id])

  certificate Certificate?
}

model Certificate {
  id            String @id @default(cuid())
  certificateNo String @unique

  workerId  String
  sessionId String @unique

  score    Float
  issuedAt DateTime @default(now())
  valid    Boolean  @default(true)

  worker Worker @relation(fields: [workerId], references: [id])

  session TrainingSession @relation(fields: [sessionId], references: [id])
}
